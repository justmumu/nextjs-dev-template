{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts",
    "docs/.vitepress/*.ts",
    "eslint.config.mjs",
    "tooling/**/*.mjs",
    "tooling/**/*.ts",
    "vitest.*config.ts",
    "tests/unit",
    "tests/contracts",
    "tests/integration",
    "tests/support"
  ]
}
