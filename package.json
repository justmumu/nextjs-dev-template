{
  "name": "nextjs-dev-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generator for the JavaScript-only Next.js development template",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "check": "node scripts/development.cjs check",
    "deps:add": "node scripts/dependencies.cjs add",
    "deps:remove": "node scripts/dependencies.cjs remove",
    "deps:upgrade": "node scripts/dependencies.cjs upgrade",
    "format": "node scripts/development.cjs format",
    "lint:fix": "node scripts/development.cjs lint:fix",
    "template:create": "node scripts/development.cjs template:create",
    "template:seed:refresh": "node scripts/development.cjs template:seed:refresh",
    "test:integration": "node scripts/development.cjs test:integration",
    "test:one": "node scripts/development.cjs test:one",
    "test:permissions": "node scripts/development.cjs test:permissions",
    "typecheck": "node scripts/development.cjs typecheck"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
